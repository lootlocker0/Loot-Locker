# Signs the per-order confirmation cookie that authorises
# GET /api/orders/[orderNumber]. Generate with:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("base64url"))'
# REQUIRED in production: with it unset, POST /api/checkout refuses rather than
# creating orders whose receipt nobody can open (lib/order-session.ts).
ORDER_SESSION_SECRET="..."

RESEND_API_KEY="..."

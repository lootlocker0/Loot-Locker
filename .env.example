DATABASE_URL="postgresql://...?sslmode=require"
DIRECT_URL="postgresql://..."              # migrations, bypasses pooler

STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

CRON_SECRET="..."                          # guards the expiry sweep route

# Signs the staff admin session cookie (ll_admin) for /api/admin/*.
# A DIFFERENT secret from ORDER_SESSION_SECRET on purpose: one is a student
# reading one receipt, the other is staff reading every child's name and
# pressing refund. Generate with:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("base64url"))'
# REQUIRED in production. Unset means nobody can sign in (fail closed).
# Rotating it invalidates every outstanding staff session immediately — that is
# the only way to revoke access, since there is no server-side session store.
ADMIN_SESSION_SECRET="..."

# The shared staff passcode. PLACEHOLDER PENDING A HUMAN DECISION — see
# docs/HANDOFF.md: there is no staff roster and no per-person account, so this
# one value is every staff member's credential and the audit log can never say
# who did what.
# Minimum 8 characters; anything shorter is treated as unset and refused.
# There is NO default and NO dev fallback, in any environment.
ADMIN_PASSCODE="..."
# Signs the per-order confirmation cookie that authorises
# GET /api/orders/[orderNumber]. Generate with:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("base64url"))'
# REQUIRED in production: with it unset, POST /api/checkout refuses rather than
# creating orders whose receipt nobody can open (lib/order-session.ts).
ORDER_SESSION_SECRET="..."

RESEND_API_KEY="..."
NEXT_PUBLIC_SITE_URL="https://lootlockers.ca"

STITCH_API_KEY="..."                       # design extraction (frontend agent P0 task)
